[
  {
    "plugin_id": "heraldr",
    "name": "Heraldr",
    "version": "0.0.4",
    "min_herdr_version": "0.7.5",
    "description": "Dress herdr tabs as [N] <icon> <program> and feed sidebar rows composable tokens: $jump (workspace jump number) plus $space/$worktree (repo + nested worktree names for agent rows). Labels stay bare for the agents panel and navigator; manual renames win. Icons reload from icons.conf with a compiled fallback.",
    "manifest_path": "/Users/winnie/.config/herdr/plugins/github-installations/heraldr-263bee430f10/91714-0/checkout/herdr-plugin.toml",
    "plugin_root": "/Users/winnie/.config/herdr/plugins/github-installations/heraldr-263bee430f10/91714-0/checkout",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "build": [
      {
        "command": [
          "sh",
          "scripts/install-binary.sh"
        ]
      }
    ],
    "actions": [
      {
        "id": "relabel-all",
        "title": "Heraldr: relabel every tab",
        "description": "Return every tab in the session to automatic naming, replacing manual names",
        "contexts": [
          "global"
        ],
        "command": [
          "heraldr",
          "relabel",
          "--scope",
          "all"
        ]
      },
      {
        "id": "relabel-tab",
        "title": "Heraldr: relabel this tab",
        "description": "Return this tab to automatic naming, replacing a manual name",
        "contexts": [
          "global"
        ],
        "command": [
          "heraldr",
          "relabel",
          "--scope",
          "tab"
        ]
      },
      {
        "id": "relabel-workspace",
        "title": "Heraldr: relabel tabs in this workspace",
        "description": "Return every tab in this workspace to automatic naming, replacing manual names",
        "contexts": [
          "global"
        ],
        "command": [
          "heraldr",
          "relabel",
          "--scope",
          "workspace"
        ]
      },
      {
        "id": "restart",
        "title": "Heraldr: restart the label watcher",
        "description": "Replace a stuck or outdated watcher with a fresh one, keeping labels and manual names",
        "contexts": [
          "global"
        ],
        "command": [
          "heraldr",
          "restart"
        ]
      },
      {
        "id": "stop-clear-all",
        "title": "Heraldr: stop and remove all labels",
        "description": "Stop the watcher and strip jump numbers, icons, and sidebar tokens until the next tab or pane event",
        "contexts": [
          "global"
        ],
        "command": [
          "heraldr",
          "clear"
        ]
      }
    ],
    "events": [
      {
        "on": "pane.agent_detected",
        "command": [
          "heraldr",
          "kick"
        ]
      },
      {
        "on": "pane.focused",
        "command": [
          "heraldr",
          "kick"
        ]
      },
      {
        "on": "tab.created",
        "command": [
          "heraldr",
          "kick"
        ]
      },
      {
        "on": "tab.focused",
        "command": [
          "heraldr",
          "kick"
        ]
      },
      {
        "on": "workspace.created",
        "command": [
          "heraldr",
          "kick"
        ]
      }
    ],
