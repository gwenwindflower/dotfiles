{
	"$schema": "https://opencode.ai/config.json",

	"model": "github-copilot/claude-opus-4.6",
	"small_model": "github-copilot/gpt-5.4-mini",
	"permission": {
		"bash": {
			"*": "ask",
			"* --help *": "allow",
			"* --version": "allow",
			"* --version *": "allow",
			"bat *": "allow",
			"blacksmith *": "allow",
			"bun build *": "allow",
			"bun dev *": "allow",
			"bun run build *": "allow",
			"bun run dev *": "allow",
			"bun run lint *": "allow",
			"bun run test *": "allow",
			"bun test *": "allow",
			"bunx skills list -g *": "allow",
			"bunx skills list *": "allow",
			"bunx skills upgrade -g *": "allow",
			"bunx skills upgrade *": "allow",
			"bunx tsc *": "allow",
			"cargo check *": "allow",
			"cargo clippy *": "allow",
			"cargo test *": "allow",
			"cat *": "allow",
			"chezmoi --dry-run --no-pager *": "allow",
			"chezmoi doctor *": "allow",
			"ctx7 docs *": "allow",
			"ctx7 library *": "allow",
			"deno check *": "allow",
			"deno fmt *": "allow",
			"deno info *": "allow",
			"deno lint *": "allow",
			"deno task *": "allow",
			"deno test *": "allow",
			"diff *": "allow",
			"echo *": "allow",
			"fallow *": "allow",
			"fd *": "allow",
			"file *": "allow",
			"find *": "allow",
			"git blame *": "allow",
			"git branch *": "allow",
			"git diff *": "allow",
			"git log *": "allow",
			"git remote -v": "allow",
			"git rev-parse *": "allow",
			"git show *": "allow",
			"git stash list": "allow",
			"git status *": "allow",
			"git tag --list *": "allow",
			"go build *": "allow",
			"go run main.go": "allow",
			"go test *": "allow",
			"go tool pprof *": "allow",
			"go vet *": "allow",
			"gofmt *": "allow",
			"gopls *": "allow",
			"grep *": "allow",
			"herdr *": "allow",
			"jq *": "allow",
			"ls *": "allow",
			"lsd *": "allow",
			"make *": "allow",
			"mise current *": "allow",
			"mise ls *": "allow",
			"mktemp *": "allow",
			"notesmd-cli search *": "allow",
			"notesmd-cli search-content *": "allow",
			"npm build *": "allow",
			"npm dev *": "allow",
			"npm fix *": "allow",
			"npm fix-format *": "allow",
			"npm format *": "allow",
			"npm lint *": "allow",
			"npm ls *": "allow",
			"npm run build *": "allow",
			"npm run dev *": "allow",
			"npm run lint *": "allow",
			"npm run test *": "allow",
			"npm typecheck *": "allow",
			"npx tsc *": "allow",
			"pnpm build *": "allow",
			"pnpm check *": "allow",
			"pnpm dev *": "allow",
			"pnpm fix *": "allow",
			"pnpm fix-format *": "allow",
			"pnpm fmt *": "allow",
			"pnpm format *": "allow",
			"pnpm lint *": "allow",
			"pnpm ls *": "allow",
			"pnpm run build *": "allow",
			"pnpm run dev *": "allow",
			"pnpm run lint *": "allow",
			"pnpm run test *": "allow",
			"pnpm typecheck *": "allow",
			"pnpx ctx7 docs *": "allow",
			"pnpx ctx7 library *": "allow",
			"pnpx fallow *": "allow",
			"pnpx skills list -g *": "allow",
			"pnpx skills list *": "allow",
			"pnpx skills upgrade -g *": "allow",
			"pnpx skills upgrade *": "allow",
			"pnpx tsc *": "allow",
			"prek *": "allow",
			"printf *": "allow",
			"procs *": "allow",
			"pwd": "allow",
			"rei *": "allow",
			"rg *": "allow",
			"ruff *": "allow",
			"sd -p *": "allow",
			"task *": "allow",
			"tree *": "allow",
			"uname *": "allow",
			"uv python upgrade *": "allow",
			"uv run pytest *": "allow",
			"uv run ruff *": "allow",
			"uv run ty *": "allow",
			"uv sync *": "allow",
			"uv tool list *": "allow",
			"uv tool upgrade *": "allow",
			"uv venv *": "allow",
			"wc *": "allow",
			"which *": "allow",
			"wt list *": "allow",
			"wt status *": "allow",
			"wt switch *": "allow",
			"yq *": "allow",
			"yuzudraw-cli *": "allow",
			"chmod -R 777 *": "deny",
			"dd *": "deny",
			"git push --force *": "deny",
			"git push -f *": "deny",
			"kubectl apply * --namespace=prod*": "deny",
			"kubectl delete *": "deny",
			"mkfs *": "deny",
			"op *": "deny",
			"rm -rf *": "deny",
			"rm -rf /*": "deny",
			"sudo rm *": "deny",
			"terraform destroy *": "deny"
		},
		"skill": "allow",
		"read": {
			".env": "deny",
			".env.*": "deny",
			"*.env": "deny",
			"**/.env": "deny",
			"**/.env.*": "deny",
			"**/*.env": "deny",
			"~/.ssh/**": "deny",
			"~/.aws/**": "deny",
			"~/.gnupg/**": "deny",
			"~/.config/gcloud/**": "deny",
			"**/secrets/**": "deny",
			"**/credentials/**": "deny",
			"*.pem": "deny",
			"*.key": "deny",
			"*.p12": "deny",
			"*.pfx": "deny",
			"id_rsa": "deny",
			"id_ed25519": "deny"
		},
		"edit": {
			".env": "deny",
			".env.*": "deny",
			"*.env": "deny",
			"*.key": "deny",
			"*.p12": "deny",
			"*.pem": "deny",
			"*.pfx": "deny",
			"**/.env": "deny",
			"**/.env.*": "deny",
			"**/*.env": "deny",
			"**/credentials/**": "deny",
			"**/secrets/**": "deny",
			"~/.aws/**": "deny",
			"~/.config/gcloud/**": "deny",
			"~/.gnupg/**": "deny",
			"~/.ssh/**": "deny",
			"id_ed25519": "deny",
			"id_rsa": "deny"
		}
	},
	// Built-ins (rustfmt, gofmt, ruff, uv, biome, shfmt) self-gate on the right
	// signals already — biome walks up for biome.json(c), ruff checks
	// pyproject/ruff.toml, uv falls back when ruff is off. We only override
	// where built-in detection doesn't match how we work:
	//   - prettier: built-in keys off `prettier` in package.json; we want to
	//     fire only when a real prettier config is present, so coexistence
	//     with biome (Astro etc.) stays intentional.
	//   - deno: no built-in; uses `find-up` (git-root-bounded ancestor walk)
	//     to detect deno.json(c).
	// Detection rides inside `sh -c` because the config schema only exposes
	// command/extensions — no triggerFiles field.
	"formatter": {
		"prettier": {
			"command": [
				"sh",
				"-c",
				"if prettier --find-config-path \"$FILE\" >/dev/null 2>&1; then prettier --write \"$FILE\"; fi"
			]
		},
		"deno": {
			"command": [
				"sh",
				"-c",
				"find-up deno.json deno.jsonc >/dev/null && exec deno fmt \"$0\"",
				"$FILE"
			],
			"extensions": [
				".js",
				".jsx",
				".mjs",
				".cjs",
				".ts",
				".tsx",
				".mts",
				".cts",
				".json",
				".jsonc",
				".md"
			]
		}
	},
	"instructions": [
		// primary source of truth
		// for multi-agent rules
		"~/.agents/rules/*.md",
		".agents/docs/**/*.md",
		".agents/rules/**/*.md",
		// project-local claude rules and docs
		// should be used, but migrated to .agents
		// if possible
		".claude/docs/**/*.md",
		".claude/rules/**/*.md"
	],
	"snapshot": true,
	// Updated via Homebrew
	"autoupdate": false
}
