# @fish-lsp-disable
# Fish shell configuration — assembled by chezmoi from .chezmoitemplates/fish/
# Do not edit the deployed ~/.config/fish/config.fish directly.
# Edit fragments in ~/.local/share/chezmoi/.chezmoitemplates/fish/ instead.

# =============================================================================
# Environment (always loaded)
# =============================================================================

# Homebrew (dynamic at chezmoi apply)
{{ if eq .chezmoi.os "darwin" -}}
{{ output (joinPath .brewPrefix "bin/brew") "shellenv" "fish" -}}
set -gx HOMEBREW_NO_ENV_HINTS 1
{{ end -}}

{{ template "fish/00-core-env.fish" . }}

{{- if eq .chezmoi.os "darwin" }}
{{ template "fish/001-mac-env.fish" . }}
{{- end }}

# On macOS, kitty sets TERM=xterm-kitty automatically.
# On Linux (SSH), kitty terminfo may not exist — use xterm-256color.
{{- if eq .chezmoi.os "linux" }}
set -gx TERM xterm-256color
{{- end }}

# Dotfiles home
set -gx DOTFILES '{{ .chezmoi.sourceDir }}'

{{ template "fish/01-git.fish" . }}
{{ template "fish/02-cloud.fish" . }}
{{ template "fish/10-rust.fish" . }}
{{ template "fish/11-typescript.fish" . }}
{{ template "fish/12-go.fish" . }}
{{ template "fish/13-python.fish" . }}
{{ template "fish/14-ruby.fish" . }}
{{ template "fish/19-finalize.fish" . }}

# =============================================================================
# Interactive-only
# =============================================================================
if status is-interactive

  {{ template "fish/20-theme.fish" . }}
  {{ template "fish/22-abbreviations.fish" . }}
  {{ template "fish/23-bindings.fish" . }}
  {{- if eq .chezmoi.os "darwin" }}
  {{ template "fish/23-bindings__macos.fish" . }}
  {{- end }}


  # ─── Dynamic Tool Initializations ──────────────────────────────────────────────────────────────────

  if command -q vivid
    set -gx LS_COLORS (vivid generate catppuccin-frappe)
  end

  # zoxide
  if command -q zoxide
    set -gx _ZO_FZF_OPTS '--no-multi --bind=enter:accept --layout=reverse --height=90%'
    zoxide init fish --no-cmd | source
    alias z=__zoxide_z
  end

  # starship
  if command -q starship
    starship init fish | source
  end

  # amoxide
  if command -q am
    am init fish | source
  end

  {{ template "fish/24-tools.fish" . }}

end # status is-interactive
