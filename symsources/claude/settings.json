        "telemetry.astro.build",
        "workers.cloudflare.com"
      ],
      "allowUnixSockets": [
        "~/.agent-browser/default.sock",
        "~/.config/herdr/herdr.sock"
      ],
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
