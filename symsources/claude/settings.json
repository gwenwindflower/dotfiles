  "model": "fable[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-teammate-git-writes.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/block-bookkeeping-commits.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/set-sandbox-tmpdir.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/set-git-nosign.sh"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/winnie/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "winline",
    "padding": 0
  },
  "enabledPlugins": {
    "deno-or-ts@winnie-local": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "mcp-apps@mcp-apps": false,
    "pyright-lsp@claude-plugins-official": false,
    "pyright-or-ruff@winnie-local": true,
    "ruby-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "worktrunk@worktrunk": true
  },
  "extraKnownMarketplaces": {
    "mcp-apps": {
      "source": {
        "source": "github",
        "repo": "modelcontextprotocol/ext-apps"
      }
    },
    "worktrunk": {
      "source": {
        "source": "github",
        "repo": "max-sixty/worktrunk"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "api.attio.com",
        "api.github.com",
        "api.linear.app",
        "api.lightdash.com",
        "backend.blacksmith.sh",
