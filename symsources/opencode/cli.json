{
  "animations": true,
  "theme": {
    "mode": "dark",
    "name": "catppuccin-frappe"
  },
  "keybinds": {
    "session.child.first": "<leader>ctrl+j",
    "session_child_cycle": "ctrl+l",
    "session_child_cycle_reverse": "ctrl+h",
    "session.parent": "ctrl+k",
    "session.message.next": "ctrl+alt+n",
    "session.message.previous": "ctrl+alt+p",
    "command.palette.show": "alt+p,super+p",
    "input.newline": "return,ctrl+j",
    "input.submit": "ctrl+return,alt+return,super+return",
    "input.move.left": "left,ctrl+b,ctrl+h",
    "input.move.right": "right,ctrl+f,ctrl+l",
    "input.move.up": "up,ctrl+p",
    "input.move.down": "down,ctrl+n",
    "input.select.left": "shift+left,ctrl+shift+b",
    "input.select.right": "shift+right,ctrl+shift+f",
    "input.select.up": "shift+up,ctrl+shift+p",
    "input.select.down": "shift+down,ctrl+shift+n",
    "input.undo": "ctrl+-,super+z,alt+z",
    "input.redo": "ctrl+.,super+shift+z,alt+shift+z",
    "input.word.forward": "alt+f,alt+l,alt+right,ctrl+right",
    "input.word.backward": "alt+b,alt+h,alt+left,ctrl+left",
    "input.select.word.forward": "alt+shift+l,ctrl+alt+shift+f,alt+shift+right",
    "input.select.word.backward": "alt+shift+h,ctrl+alt+shift+b,alt+shift+left",
    "input.delete.word.forward": "ctrl+alt+shift+l,alt+d,alt+delete,ctrl+delete",
    "input.delete.word.backward": "ctrl+alt+shift+h,ctrl+w,ctrl+backspace,alt+backspace"
  },
  "plugins": ["./herdr-opencode"]
}
