[
  {
    "plugin_id": "heraldr",
    "name": "Heraldr",
    "version": "0.0.1",
    "min_herdr_version": "0.7.5",
    "description": "Dress herdr tabs as [N] <icon> <program> and feed sidebar rows composable tokens: $jump (workspace jump number) plus $space/$worktree (repo + nested worktree names for agent rows). Labels stay bare for the agents panel and navigator; manual renames win. Icons reload from icons.conf with a compiled fallback.",
    "manifest_path": "/Users/winnie/dev/herdr/heraldr/herdr-plugin.toml",
    "plugin_root": "/Users/winnie/dev/herdr/heraldr",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "build": [
      {
        "command": [
          "sh",
          "scripts/install-binary.sh"
        ]
      }
    ],
    "actions": [
      {
        "id": "clear",
        "title": "Heraldr: strip all chrome",
        "contexts": [
          "global"
        ],
        "command": [
          "heraldr",
          "clear"
        ]
      },
      {
        "id": "reset",
        "title": "Heraldr: reset tab to automatic naming",
        "contexts": [
          "global"
        ],
        "command": [
          "heraldr",
          "reset"
        ]
      }
    ],
    "events": [
      {
        "on": "pane.agent_detected",
        "command": [
          "heraldr",
          "kick"
        ]
      },
      {
        "on": "pane.focused",
        "command": [
          "heraldr",
          "kick"
        ]
      },
      {
        "on": "tab.created",
        "command": [
          "heraldr",
          "kick"
        ]
      },
      {
        "on": "tab.focused",
        "command": [
          "heraldr",
          "kick"
        ]
      },
      {
        "on": "workspace.created",
        "command": [
          "heraldr",
          "kick"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  },
