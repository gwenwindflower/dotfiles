		"build": [
			{
				"command": ["cargo", "build", "--locked", "--release"]
			}
		],
		"actions": [
			{
				"id": "clear",
				"title": "Livery: strip all chrome",
				"contexts": ["global"],
				"command": ["target/release/livery", "clear"]
			},
			{
				"id": "reset",
				"title": "Livery: reset tab to automatic naming",
				"contexts": ["global"],
				"command": ["target/release/livery", "reset"]
			}
		],
		"events": [
			{
