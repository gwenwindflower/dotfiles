{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"agentPushNotifEnabled": true,
	"autoMemoryEnabled": false,
	"autoMode": {
		"soft_deny": [
			"User-level configs: editing dotfiles in chezmoi is allowed, but applying them out into userspace or editing user-level configs directly is blocked"
		],
		"allow": [
			"Allow worktrees to explore and read from the source worktrees they branched off from",
			"Allow all projects within a ~/dev/_supermodel/_clients/<client> directory to explore and read from each other"
		]
	},
	"awaySummaryEnabled": false,
	"editorMode": "vim",
	"effortLevel": "high",
	"enabledPlugins": {
		"deno-or-ts@winnie-local": true,
		"gopls-lsp@claude-plugins-official": true,
		"lua-lsp@claude-plugins-official": true,
		"mcp-apps@mcp-apps": true,
		"pyright-lsp@claude-plugins-official": false,
		"pyright-or-ruff@winnie-local": true,
		"ruby-lsp@claude-plugins-official": true,
		"rust-analyzer-lsp@claude-plugins-official": true,
		"typescript-lsp@claude-plugins-official": false,
		"worktrunk@worktrunk": true
	},
	"env": {
		"CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
		"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
		"CLAUDE_CODE_ENABLE_TELEMETRY": "0",
		"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
		"DISABLE_AUTO_UPDATER": "1",
		"ENABLE_CLAUDEAI_MCP_SERVERS": "false"
	},
	"extraKnownMarketplaces": {
		"mcp-apps": {
			"source": {
				"repo": "modelcontextprotocol/ext-apps",
				"source": "github"
			}
		},
		"worktrunk": {
			"source": {
				"repo": "max-sixty/worktrunk",
				"source": "github"
			}
		}
	},
	"hooks": {
		"PreToolUse": [
			{
				"hooks": [
					{
						"command": "$HOME/.claude/hooks/worktree-guardrails.sh",
						"type": "command"
					}
				],
				"matcher": "Write|Edit|NotebookEdit"
			},
			{
				"hooks": [
					{
						"command": "$HOME/.claude/hooks/block-cross-worktree-bash.sh",
						"type": "command"
					}
				],
				"matcher": "Bash"
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"command": "$HOME/.claude/hooks/set-sandbox-tmpdir.sh",
						"type": "command"
					},
					{
						"command": "$HOME/.claude/hooks/set-git-nosign.sh",
						"type": "command"
					}
				],
				"matcher": ""
			},
			{
				"hooks": [
					{
						"command": "bash '/Users/winnie/.claude/hooks/herdr-agent-state.sh' session",
						"timeout": 10,
						"type": "command"
					}
				],
				"matcher": "*"
			}
		],
		"SubagentStart": [
			{
				"hooks": [
					{
						"command": "$HOME/.claude/hooks/dev-worktree-anchor.sh",
						"type": "command"
					}
				],
				"matcher": "dev"
			}
		],
		"TaskCompleted": [
			{
				"hooks": [
					{
						"command": "$HOME/.claude/hooks/require-teammate-commit.sh",
						"type": "command"
					}
				],
				"matcher": ""
			}
		]
	},
	"maxSkillDescriptionCharacters": "1000",
