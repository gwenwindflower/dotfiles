{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "@std/fmt/colors": "jsr:@std/fmt@^1/colors",
    "@std/fs": "jsr:@std/fs@^1",
    "@std/jsonc": "jsr:@std/jsonc@^1",
    "@std/path": "jsr:@std/path@^1",
    "@std/toml": "jsr:@std/toml@^1",
    "@std/yaml": "jsr:@std/yaml@^1",
    "@cliffy/command": "jsr:@cliffy/command@^1.0.0-rc.7",
    "text-to-svg": "npm:text-to-svg@^3.1.5"
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "fix-tables": "deno run --allow-read --allow-write fix-md-tables.ts",
    "check-tables": "deno run --allow-read fix-md-tables.ts --check",
    "preview-tables": "deno run --allow-read fix-md-tables.ts --dry-run",
    "logo": "deno run --allow-read --allow-write --allow-env generate-logo.ts",
    "lscolors": "deno run --allow-env lscolors_to_toml.ts",
    "scrape-stars": "deno run --allow-run=agent-browser,gh --allow-read --allow-write --allow-env scrape-github-stars.ts",
    "packy": "deno run --allow-read --allow-write --allow-env --allow-run=chezmoi,brew,cargo,uv packy.ts",
    "herdir": "deno run --allow-read --allow-write=assets/herdir-snapshots --allow-env=HOME --allow-run=herdr herdir.ts",
    "git-wash": "deno run --allow-read --allow-write --allow-run=git,gh git-wash.ts",
    "test": "deno run --allow-read --allow-run=deno scripts/test.ts",
    "test:tables": "deno test --allow-read fix-md-tables_test.ts",
    "test:logo": "deno test --allow-read --allow-env generate-logo_test.ts",
    "test:lscolors": "deno test lscolors_to_toml_test.ts",
    "test:stars": "deno test --allow-read scrape-github-stars_test.ts",
    "test:packy": "deno test packy_test.ts",
    "test:herdir": "deno test --allow-read --allow-write herdir_test.ts",
    "test:herdr-agent-picker": "deno test --allow-read --allow-write --allow-run=sh herdr-agent-picker_test.ts",
    "test:git-wash": "deno test --allow-read --allow-write --allow-run=git git-wash_test.ts"
  }
}
