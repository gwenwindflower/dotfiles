{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/fmt/colors": "jsr:@std/fmt@^1.0.10/colors",
    "@std/fs": "jsr:@std/fs@^1.0.24",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.3",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@std/toml": "jsr:@std/toml@^1.0.11",
    "@std/yaml": "jsr:@std/yaml@^1.3.0",
    "@cliffy/command": "jsr:@cliffy/command@^1.3.1",
    "@types/opentype.js": "npm:@types/opentype.js@^1.3.10",
    "opentype.js": "npm:opentype.js@^2.0.0"
  },
  "tasks": {
    "fix-tables": "deno run --allow-read --allow-write fix-md-tables.ts",
    "check-tables": "deno run --allow-read fix-md-tables.ts --check",
    "preview-tables": "deno run --allow-read fix-md-tables.ts --dry-run",
    "logo": "deno run --allow-read --allow-write --allow-env generate-logo.ts",
    "lscolors": "deno run --allow-env lscolors_to_toml.ts",
    "scrape-stars": "deno run --allow-run=agent-browser,gh --allow-read --allow-write --allow-env scrape-github-stars.ts",
    "packy": "deno run --allow-read --allow-write --allow-env --allow-run=chezmoi,brew,cargo,uv packy.ts",
    "git-wash": "deno run --allow-read --allow-write --allow-run=git,gh git-wash.ts",
    "termshot": "deno run --allow-read --allow-write --allow-env=HOME --allow-run=termframe,resvg termshot.ts",
    "skillet": "deno run --allow-read --allow-write --allow-env --allow-run=gh,git skillet.ts",
    "itch": "deno run --allow-read --allow-write --allow-run=git itch.ts",
    "test": "deno run --allow-read --allow-run=deno scripts/test.ts",
    "test:tables": "deno test --allow-read fix-md-tables_test.ts",
    "test:logo": "deno test --allow-read --allow-env generate-logo_test.ts",
    "test:lscolors": "deno test lscolors_to_toml_test.ts",
    "test:stars": "deno test --allow-read scrape-github-stars_test.ts",
    "test:packy": "deno test packy_test.ts",
    "test:herdr-agent-picker": "deno test --allow-read --allow-write --allow-run=sh herdr-agent-picker_test.ts",
    "test:git-wash": "deno test --allow-read --allow-write --allow-run=git git-wash_test.ts",
    "test:termshot": "deno test termshot_test.ts",
    "test:skillet": "deno test --allow-read skillet_test.ts",
    "test:itch": "deno test --allow-read --allow-write --allow-run=git itch_test.ts",
    "test:agency-unit": "deno test agency_test.ts",
    "test:agency-rules-allow": "deno test --allow-read --allow-run=codex --filter '/ → allow$/' agency_rules_test.ts",
    "test:agency-rules-none": "deno test --allow-read --allow-run=codex --filter '/ → none$/' agency_rules_test.ts",
    "test:agency-rules-prompt": "deno test --allow-read --allow-run=codex --filter '/ → prompt$/' agency_rules_test.ts",
    "test:agency-rules-forbidden": "deno test --allow-read --allow-run=codex --filter '/ → forbidden$/' agency_rules_test.ts",
    "test:agency-sandbox-reads": "deno test --allow-read --allow-write --allow-env --allow-run=codex --filter '/ reads: /' agency_sandbox_test.ts",
    "test:agency-sandbox-writes": "deno test --allow-read --allow-write --allow-env --allow-run=codex --filter '/ writes: /' agency_sandbox_test.ts",
    "test:agency-sandbox-network": "deno test --allow-read --allow-write --allow-env --allow-run=codex --filter '/ network: /' agency_sandbox_test.ts",
    "test:agency-sandbox-integrations": "deno test --allow-read --allow-write --allow-env --allow-run=codex --filter '/ integrations: /' agency_sandbox_test.ts"
  }
}
