nvim.log

# Scratch space
tmp/*
!tmp/.gitkeep

# Kulala private layers — resolved secrets, 1Password reference templates, and
# local-only investigation collections. Mirrors .chezmoiignore so these never
# land in the repo even if they are added to the source tree.
private_dot_config/kulala/_local/
private_dot_config/kulala/**/http-client.private.env.json
private_dot_config/kulala/**/http-client.private.env.op.json
