{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Install Rust via rustup (darwin only)
# Linux dev boxes currently arrive with popular runtimes pre-installed.

set -euo pipefail

{{ template "script-log.sh" }}

log_step "Installing Rust"

if command -v rustup >/dev/null 2>&1; then
  log_info "Checking Rust updates..."
  rustup check
  log_info "Installing or updating stable Rust toolchain..."
  rustup toolchain install stable --profile default
  rustup default stable
  log_success "Rust updated"
  exit 0
fi

if ! command -v curl >/dev/null 2>&1; then
  log_error "curl not found"
  exit 1
fi

log_info "Installing stable Rust toolchain via rustup..."
curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs | sh -s -- \
  -y \
  --default-toolchain stable \
  --profile default \
  --no-modify-path

log_success "Rust installed"
{{ end -}}
