{{ if eq .chezmoi.os "darwin" "linux" -}}
#!/bin/bash
# Install global CLIs managed by uv (darwin only).
# JS/TS globals are materialized by run_onchange_18-mise-install.sh.tmpl.

set -euo pipefail

{{ template "script-log.sh" }}

{{- $os := .chezmoi.os -}}
{{- $pkgs := index .packages $os -}}
{{- $uvTools := list -}}
{{- if hasKey $pkgs "uv" -}}{{ $uvTools = concat $pkgs.uv.core (index $pkgs.uv .profile | default (list)) -}}{{- end }}

{{ if $uvTools -}}
if ! command -v uv >/dev/null 2>&1; then
  log_error "uv not found — Homebrew install may have failed"
  exit 1
fi

log_step "Installing uv tools"

{{ range $uvTools -}}
if uv tool list 2>/dev/null | grep -q "^{{ . }} "; then
  log_info "{{ . }} already installed"
else
  log_info "Installing {{ . }}..."
  uv tool install {{ . | quote }}
  log_success "{{ . }}"
fi
{{ end -}}

log_success "uv tools complete"
{{ end -}}
{{ else -}}
{{ fail (printf "unsupported OS: %s" .chezmoi.os) }}
{{ end -}}
