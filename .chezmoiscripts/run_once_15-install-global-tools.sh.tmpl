{{ if eq .chezmoi.os "darwin" "linux" -}}
#!/bin/bash
# Install global CLIs managed by pnpm and uv
# Runs after Homebrew packages (15 > 10) so both tools are available

set -euo pipefail

{{ template "script-log.sh" }}

{{- $os := .chezmoi.os -}}
{{- $pkgs := index .packages $os -}}
{{- $pnpmGlobals := list -}}
{{- if hasKey $pkgs "pnpm" -}}{{ $pnpmGlobals = concat $pkgs.pnpm.core (index $pkgs.pnpm .profile | default (list)) -}}{{- end -}}
{{- $uvTools := list -}}
{{- if hasKey $pkgs "uv" -}}{{ $uvTools = concat $pkgs.uv.core (index $pkgs.uv .profile | default (list)) -}}{{- end }}

# --- pnpm globals ---

{{ if $pnpmGlobals -}}
if ! command -v pnpm >/dev/null 2>&1; then
  log_error "pnpm not found — Homebrew install may have failed"
  exit 1
fi

log_step "Installing pnpm global packages"

# pnpm ls -g <pkg> exits 0 even when the package isn't installed, so a per-pkg
# check is useless. Gather installed names once via JSON, then grep membership.
INSTALLED_PNPM=$(pnpm ls -g --depth=0 --json 2>/dev/null \
  | jq -r '.[0].dependencies // {} | keys[]?')

{{ range $pnpmGlobals -}}
if printf '%s\n' "$INSTALLED_PNPM" | grep -qx {{ . | quote }}; then
  log_info "{{ . }} already installed"
else
  log_info "Installing {{ . }}..."
  pnpm add -g {{ . | quote }}
  log_success "{{ . }}"
fi
{{ end -}}

log_success "pnpm global packages complete"
{{ end -}}

# --- uv tools (darwin only) ---

{{ if $uvTools -}}
if ! command -v uv >/dev/null 2>&1; then
  log_error "uv not found — Homebrew install may have failed"
  exit 1
fi

log_step "Installing uv tools"

{{ range $uvTools -}}
if uv tool list 2>/dev/null | grep -q "^{{ . }} "; then
  log_info "{{ . }} already installed"
else
  log_info "Installing {{ . }}..."
  uv tool install {{ . | quote }}
  log_success "{{ . }}"
fi
{{ end -}}

log_success "uv tools complete"
{{ end -}}
{{ else -}}
{{ fail (printf "unsupported OS: %s" .chezmoi.os) }}
{{ end -}}
