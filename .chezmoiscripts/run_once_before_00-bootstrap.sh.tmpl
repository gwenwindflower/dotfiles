{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh
# Bootstrap: ensure Homebrew is installed and available (darwin only)

set -eu

{{ template "script-log.sh" }}

log_step "Bootstrap"

# Check if brew is already available
if command -v brew >/dev/null 2>&1; then
  log_success "Homebrew already installed"
  exit 0
fi

log_info "Installing Homebrew..."

# Homebrew needs sudo to create its root-owned prefix. Under NONINTERACTIVE it
# probes with `sudo -n` (never prompts) and aborts ("Need sudo access") when no
# credential is cached — always the case on a fresh machine. Prime sudo with one
# interactive prompt first; skip without a TTY (CI must grant passwordless sudo).
if [ -t 0 ]; then
  log_info "Priming sudo for the Homebrew install..."
  sudo -v
fi

if NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
  log_success "Homebrew installed successfully"
else
  log_error "Failed to install Homebrew"
  exit 1
fi

# Verify brew is on PATH after install
{{ template "brew-preamble.sh" . }}
log_success "Homebrew verified on PATH: $(brew --prefix)"
{{ end -}}
