{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Install Homebrew packages (formulae + casks) — darwin only
# Taps are handled by run_once_05-add-taps.sh.tmpl

set -euo pipefail

{{ template "script-log.sh" }}
{{ template "brew-preamble.sh" . }}

log_step "Installing Homebrew packages"

{{- $taps := concat .packages.darwin.homebrew.taps.core (index .packages.darwin.homebrew.taps .profile | default (list)) }}
{{ if $taps -}}
# Verify taps are available before installing packages that depend on them.
# Single `brew tap` call replaces per-tap `brew tap-info` (which can hit network).
INSTALLED_TAPS="$(brew tap)"
{{ range $taps -}}
if ! grep -qxF {{ . | quote }} <<<"$INSTALLED_TAPS"; then
  log_error "Required tap {{ . | quote }} is missing — run_once_05 may have failed"
  exit 1
fi
{{ end -}}
log_info "All required taps present"
{{ end -}}

{{- $hb := .packages.darwin.homebrew -}}
{{- $formulae := concat $hb.formulae.core (index $hb.formulae .profile | default (list)) -}}
{{- $casks := concat $hb.casks.core (index $hb.casks .profile | default (list)) -}}
log_info "Installing {{ len $formulae }} formulae and {{ len $casks }} casks..."

brew bundle --file=/dev/stdin <<EOF
{{ range $formulae -}}
brew {{ . | quote }}
{{ end -}}
{{ range $casks -}}
cask {{ . | quote }}
{{ end -}}
EOF

log_success "Package installation complete"
{{ end -}}
