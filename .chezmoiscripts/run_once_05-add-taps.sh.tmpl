{{ if eq .chezmoi.os "darwin" -}}
{{- $taps := concat .packages.darwin.homebrew.taps.core (index .packages.darwin.homebrew.taps .profile | default (list)) -}}
{{- if not $taps -}}
#!/bin/sh
# No taps defined for darwin — nothing to do
exit 0
{{ else -}}
#!/bin/bash
# Add Homebrew taps with retry and verification (darwin only)
# Runs before package install (05 < 10)

set -euo pipefail

{{ template "script-log.sh" }}
{{ template "brew-preamble.sh" . }}

log_step "Adding Homebrew taps"

MAX_RETRIES=3
RETRY_DELAY=5

# Single fast call lists every currently-installed tap; per-tap subcommands
# below short-circuit on cache hit, avoiding brew's per-invocation auto-update.
INSTALLED_TAPS="$(brew tap)"

tap_installed() {
  grep -qxF "$1" <<<"$INSTALLED_TAPS"
}

add_tap() {
  local tap="$1"
  if tap_installed "$tap"; then
    log_success "$tap (already tapped)"
    return 0
  fi

  local attempt=1
  while [ $attempt -le $MAX_RETRIES ]; do
    log_info "Tapping $tap..."
    if brew tap "$tap" 2>/dev/null; then
      log_success "$tap"
      return 0
    fi
    log_warn "Tap '$tap' failed (attempt $attempt/$MAX_RETRIES), retrying in ${RETRY_DELAY}s..."
    sleep $RETRY_DELAY
    attempt=$((attempt + 1))
  done

  log_error "Failed to add tap '$tap' after $MAX_RETRIES attempts"
  exit 1
}

{{ range $taps -}}
add_tap {{ . | quote }}
{{ end -}}

log_success "All taps present"
{{ end -}}
{{ end -}}
