{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Install Linux CLI tools with cargo-binstall.

set -euo pipefail

{{ template "script-log.sh" }}

log_step "Cargo binary tools"

export PATH="$HOME/.cargo/bin:$PATH"

if ! command -v cargo >/dev/null 2>&1; then
  log_error "cargo not found; run_once_16-install-rust should have installed it"
  exit 1
fi

if ! command -v cargo-binstall >/dev/null 2>&1; then
  log_info "Installing cargo-binstall..."
  curl -L --proto '=https' --tlsv1.2 -sSf \
    https://raw.githubusercontent.com/cargo-bins/cargo-binstall/main/install-from-binstall-release.sh |
    bash
fi

if ! command -v cargo-binstall >/dev/null 2>&1; then
  log_error "cargo-binstall installation completed but cargo-binstall is not on PATH"
  exit 1
fi

{{ $packages := concat .packages.linux.cargo.core (index .packages.linux.cargo .profile | default (list)) -}}
packages=(
{{ range $packages -}}
  {{ . | quote }}
{{ end -}}
)

log_info "Installing ${#packages[@]} Cargo binary tool(s)..."
cargo binstall --no-confirm "${packages[@]}"

log_success "Cargo binary tools installed"
{{ end -}}
