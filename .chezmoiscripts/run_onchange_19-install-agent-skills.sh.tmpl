{{ if eq .chezmoi.os "darwin" "linux" -}}
#!/bin/bash
# Re-runs when a skill's source, path, or tree SHA in the gh skill manifest
# changes; the manifest's timestamps are deliberately left out of the content.

set -euo pipefail

{{ template "script-log.sh" }}
{{- if eq .chezmoi.os "darwin" }}
{{ template "brew-preamble.sh" . }}
{{- end }}

log_step "Agent skills"

if ! command -v gh >/dev/null 2>&1; then
  log_error "gh not found; system package installation should have installed it"
  exit 1
fi

if ! gh auth status >/dev/null 2>&1; then
  log_warn "gh is not authenticated; skipping skill install"
  log_warn "After 'gh auth login', run: gh skill install gwenwindflower/dotfiles --all --agent universal --scope user"
  exit 0
fi

skills_dir="$HOME/.agents/skills"
mkdir -p "$skills_dir"

installed_tree_sha() {
  awk 'NR > 1 && /^---$/ { exit } /^ *github-tree-sha:/ { print $2; exit }' "$skills_dir/$1/SKILL.md"
}

stale=()
reconcile_skill() {
  local name="$1" source="$2" path="$3" tree_sha="$4"
  if [[ ! -f "$skills_dir/$name/SKILL.md" ]]; then
    log_info "Installing $name from $source"
    gh skill install "$source" "$path" --agent universal --scope user \
      || log_warn "$name failed to install; if $source no longer ships it, drop it from the manifest"
    return 0
  fi
  if [[ "$(installed_tree_sha "$name")" != "$tree_sha" ]]; then
    stale+=("$name")
  fi
}

{{ range $name, $skill := (include "symsources/agents/skill-lock.json" | fromJson).skills -}}
reconcile_skill {{ $name | quote }} {{ $skill.source | quote }} {{ $skill.skillPath | quote }} {{ $skill.skillFolderHash | quote }}
{{ end -}}

if [[ "${#stale[@]}" -gt 0 ]]; then
  log_info "Updating ${#stale[@]} skill(s) behind the manifest: ${stale[*]}"
  gh skill update "${stale[@]}" --all --dir "$skills_dir"
fi

log_success "Agent skills are available"
{{ else -}}
{{ fail (printf "unsupported OS: %s" .chezmoi.os) }}
{{ end -}}
