# open: these need host resources (the chezmoi state database and every managed target,
# Chrome, the GPU) and are routine.
prefix_rule(
    pattern = ["chezmoi", ["--dry-run", "-n", "diff", "status", "verify", "doctor", "cat", "data", "managed", "source-path", "target-path", "execute-template", "ignored", "cat-config", "dump-config"]],
    decision = "allow",
    justification = "Dotfiles inspection and dry runs read every managed target and chezmoi's state database on the host.",
    match = ["chezmoi --dry-run --no-pager apply", "chezmoi -n --no-pager apply ~/.agents", "chezmoi diff --no-pager", "chezmoi status", "chezmoi doctor"],
    not_match = ["chezmoi apply", "chezmoi add ~/.zshrc", "chezmoi state dump"],
)

prefix_rule(
    pattern = ["agent-browser", ["screenshot", "snapshot", "pdf", "close"]],
    decision = "allow",
    justification = "Routine browser capture and cleanup run on the host because Chromium cannot launch inside the sandbox.",
    match = ["agent-browser screenshot page.png", "agent-browser snapshot -i", "agent-browser pdf page.pdf", "agent-browser close"],
    not_match = ["agent-browser open https://example.com", "agent-browser cookies get"],
)

prefix_rule(
    pattern = ["agent-browser", "--profile", "Default", ["screenshot", "snapshot", "pdf", "close"]],
    decision = "allow",
    justification = "Capture and cleanup stay routine when the Default profile is selected.",
    match = ["agent-browser --profile Default screenshot page.png", "agent-browser --profile Default pdf page.pdf"],
    not_match = ["agent-browser --profile Default open https://example.com"],
)

prefix_rule(
    pattern = ["cap", ["doctor", "targets"]],
    decision = "allow",
    justification = "Cap's screen-recording permission and ScreenCaptureKit are only visible on the host; in the sandbox these report no permission and an empty display.",
    match = ["cap doctor --json", "cap targets --json"],
    not_match = ["cap caps list --json", "cap record start --screen 0"],
)

prefix_rule(
    pattern = ["qmd", ["embed", "query", "vsearch"]],
    decision = "allow",
    justification = "Local embedding and vector search load models on the GPU, which the sandbox blocks.",
    match = ["qmd embed", "qmd query 'agent config'"],
    not_match = ["qmd collection remove notes"],
)

# review: these would succeed in the sandbox (network, socket, or granted state), so they
# are routed to the reviewer explicitly. The review policy decides in-scope vs. on request.
prefix_rule(
    pattern = ["chezmoi", ["apply", "update", "init"]],
    decision = "prompt",
    justification = "A real chezmoi apply rewrites the whole home directory. Approve only when the user's message asked to apply after the changes; verification uses chezmoi --dry-run --no-pager apply and chezmoi diff. Request escalation with this command.",
    match = ["chezmoi apply", "chezmoi apply ~/.config/fish", "chezmoi update", "chezmoi init --apply"],
    not_match = ["chezmoi --dry-run --no-pager apply", "chezmoi diff"],
)

prefix_rule(
    pattern = ["chezmoi", ["add", "re-add", "forget", "chattr", "edit"]],
    decision = "prompt",
    justification = "Changing the chezmoi source from targets follows the task's scope. Request escalation with this command.",
    match = ["chezmoi add ~/.zshrc", "chezmoi re-add"],
    not_match = ["chezmoi cat ~/.zshrc"],
)

prefix_rule(
    pattern = ["agent-browser", "--profile", "Default"],
    decision = "prompt",
    justification = "The Default profile carries signed-in, Keychain-backed browser state; use it beyond capture only when the user's current request asks for it. Request escalation with this command.",
    match = ["agent-browser --profile Default open https://example.com"],
)

prefix_rule(
    pattern = ["cap", ["screenshot", "export"]],
    decision = "prompt",
    justification = "Screen capture and exports run for the task in hand; capture needs the host's screen-recording permission. Request escalation with this command.",
    match = ["cap screenshot --screen 0 --output shot.png", "cap export a.cap --output out.mp4"],
    not_match = ["cap doctor --json"],
)

prefix_rule(
    pattern = ["cap", "record"],
    decision = "prompt",
    justification = "Screen and camera recording runs only when the user asked for a recording, and needs the host's screen-recording permission. Request escalation with this command.",
    match = ["cap record start --screen 0 --detach --json", "cap record stop --id abc --json", "cap record windows --json"],
    not_match = ["cap recordings list --json", "cap targets --json"],
)

prefix_rule(
    pattern = ["cap", ["upload", "update", "agents", "library"]],
    decision = "prompt",
    justification = "Uploading publishes a shareable link, and these change Cap Desktop, agent config, or shared library state.",
    match = ["cap upload out.mp4 --json", "cap library folders list --json", "cap agents install --target codex --component skill"],
    not_match = ["cap caps list --json"],
)

prefix_rule(
    pattern = ["cap", "caps", ["process", "import", "transcript-replace", "download", "duplicate", "delete", "password", "unlock", "comments", "reactions", "update", "sharing", "settings", "date", "move", "shares"]],
    decision = "prompt",
    justification = "These change a Cap's content, sharing, or location, can start paid processing, or write its media to disk.",
    match = ["cap caps delete abc --yes", "cap caps sharing set abc --public", "cap caps download abc --output a.mp4"],
    not_match = ["cap caps context abc --json", "cap caps transcript abc --output t.txt"],
)

prefix_rule(
    pattern = ["cap", "account", ["update", "image", "referrals", "sign-out-all"]],
    decision = "prompt",
    justification = "Account changes, including signing out every session, need the user's request.",
    match = ["cap account sign-out-all", "cap account update --name x"],
    not_match = ["cap account get --json"],
)

prefix_rule(
    pattern = ["cap", "organizations", ["create", "members", "invites", "billing", "storage", "update", "icon", "shareable-icon", "settings", "invite", "member", "domain", "delete"]],
    decision = "prompt",
    justification = "Organization membership, billing, storage, and settings are shared state.",
    match = ["cap organizations invite add x@example.com", "cap organizations delete abc"],
    not_match = ["cap organizations list --json"],
)

prefix_rule(
    pattern = ["cap", "developers", ["create", "update", "delete", "domains", "keys", "auto-top-up"]],
    decision = "prompt",
    justification = "Developer apps, keys, and billing top-ups need the user's request.",
    match = ["cap developers keys create abc", "cap developers auto-top-up abc"],
    not_match = ["cap developers list --json"],
)

prefix_rule(
    pattern = ["cap", "auth", ["login", "logout"]],
    decision = "prompt",
    justification = "Authentication through Cap is routine in task scope; the user completes the browser handoff.",
    match = ["cap auth login --json"],
    not_match = ["cap auth status --json"],
)

prefix_rule(
    pattern = ["agent-browser", ["cookies", "storage", "state"]],
    decision = "prompt",
    justification = "Exporting browser session state needs the user's request. Request escalation with this command.",
    match = ["agent-browser cookies get", "agent-browser state save s.json"],
    not_match = ["agent-browser snapshot"],
)

prefix_rule(
    pattern = ["linear-cli", ["issues", "comments", "documents", "labels", "projects", "project-updates", "attachments", "milestones", "initiatives", "relations", "templates", "views", "webhooks", "favorites", "time", "sprint", "triage", "roadmaps", "notifications"], ["create", "update", "delete", "archive", "unarchive", "assign", "unassign", "add", "remove", "move", "close", "reopen", "link", "unlink", "start", "stop", "log", "mark", "apply", "set"]],
    decision = "prompt",
    justification = "Linear writes follow the task's scope in the Lightdash workspace; deletions and archives need the user's request.",
    match = ["linear-cli issues create 'Fix bug' --team ENG", "linear-cli comments create ENG-1 --body ok", "linear-cli issues update ENG-1 --state Done"],
    not_match = ["linear-cli issues get ENG-1", "linear-cli issues list", "linear-cli search agent"],
)

prefix_rule(
    pattern = ["linear-cli", ["bulk", "import", "sync", "done"]],
    decision = "prompt",
    justification = "Bulk changes, imports, and syncs are reviewed as one change set in the task's scope.",
    match = ["linear-cli bulk update --state Done", "linear-cli done"],
    not_match = ["linear-cli whoami"],
)

prefix_rule(
    pattern = ["linear-cli", "api", "mutate"],
    decision = "prompt",
    justification = "Raw GraphQL mutations follow the task's scope, judged as the equivalent command.",
    match = ["linear-cli api mutate '...'"],
    not_match = ["linear-cli api query '{ viewer { id } }'"],
)

prefix_rule(
    pattern = ["lightdash", ["upload", "deploy", "refresh", "start-preview", "stop-preview", "preview", "set-warehouse", "rename", "slug-update", "install-skills"]],
    decision = "prompt",
    justification = "Lightdash writes follow the task's scope for non-production projects; production projects need the user's request.",
    match = ["lightdash deploy --create", "lightdash upload", "lightdash start-preview"],
    not_match = ["lightdash compile", "lightdash validate", "lightdash sql 'select 1'"],
)

prefix_rule(
    pattern = ["herdr", "pane", ["send-text", "send-keys", "run", "close"]],
    decision = "prompt",
    justification = "Driving a pane reaches whatever runs there; act on panes the session created or the user named.",
    match = ["herdr pane run 2 'npm test'", "herdr pane send-keys 3 C-c"],
    not_match = ["herdr pane list", "herdr pane read 2"],
)

prefix_rule(
    pattern = ["herdr", "agent", ["send-keys", "prompt", "attach"]],
    decision = "prompt",
    justification = "Driving another agent passes this session's authority to it; act on agents the session started or the user named.",
    match = ["herdr agent prompt 2 'run tests'", "herdr agent send-keys 2 Enter"],
    not_match = ["herdr agent list", "herdr agent read 2", "herdr agent start codex --kind codex --pane 3"],
)

prefix_rule(
    pattern = ["herdr", ["pane", "tab", "workspace", "agent"], "focus"],
    decision = "prompt",
    justification = "Focus belongs to the user; move it only when the user asked.",
    match = ["herdr pane focus --direction left", "herdr tab focus 2"],
    not_match = ["herdr pane split --current --direction right --no-focus"],
)

prefix_rule(
    pattern = ["herdr", ["pane", "workspace"], ["report-agent", "report-agent-session", "release-agent", "report-metadata"]],
    decision = "prompt",
    justification = "Agent status and metadata reports belong to harness hooks, not agent commands.",
    match = ["herdr pane report-agent 2 --source x --agent claude --state idle"],
    not_match = ["herdr pane read 2"],
)

prefix_rule(
    pattern = ["herdr", "worktree", ["create", "remove"]],
    decision = "prompt",
    justification = "Worktrees are created and removed through wt so project hooks run; herdr only opens them.",
    match = ["herdr worktree create --branch x", "herdr worktree remove --workspace 2"],
    not_match = ["herdr worktree open --branch x --no-focus", "herdr worktree list --cwd ."],
)

prefix_rule(
    pattern = ["herdr", ["tab", "workspace", "session"], ["close", "stop", "delete"]],
    decision = "prompt",
    justification = "Closing tabs, workspaces, or sessions can end other work; act on ones the session created or the user named.",
    match = ["herdr tab close 2", "herdr session stop work"],
    not_match = ["herdr tab list"],
)

prefix_rule(
    pattern = ["herdr", ["server", "update", "config", "integration", "machine", "channel"]],
    decision = "prompt",
    justification = "herdr administration changes the user's terminal environment; it needs the user's request.",
    match = ["herdr server reload-config", "herdr update", "herdr config reset-keys"],
    not_match = ["herdr status", "herdr api schema"],
)

prefix_rule(
    pattern = [["codex", "claude"], ["mcp", "plugin", "features", "config"], ["add", "remove", "enable", "disable", "set", "install", "uninstall"]],
    decision = "prompt",
    justification = "Agent MCP, plugin, and feature changes are a trust surface that changes only on the user's request.",
    match = ["codex mcp add x -- cmd", "codex features enable js_repl", "claude mcp add x cmd"],
    not_match = ["codex mcp list", "codex features list"],
)

prefix_rule(
    pattern = [["codex", "claude"], ["exec", "-p", "--print"]],
    decision = "prompt",
    justification = "A nested agent inherits none of this session's review; run one only when the task calls for it.",
    match = ["codex exec 'summarize'", "claude -p 'hi'"],
    not_match = ["codex --version"],
)

# user-open: the user runs these.
prefix_rule(
    pattern = ["chezmoi", ["state", "purge", "manage", "unmanage", "destroy"]],
    decision = "forbidden",
    justification = "chezmoi state, purge, and unmanage change what chezmoi tracks; give the user the exact command to run.",
    match = ["chezmoi state delete-bucket --bucket=scriptState", "chezmoi purge"],
    not_match = ["chezmoi status"],
)

# review: authentication and non-secret configuration are routine in task scope.
prefix_rule(
    pattern = [["codex", "claude"], ["login", "logout"]],
    decision = "prompt",
    justification = "Authentication through the owning agent CLI is routine in task scope; trust and permission changes still need a direct request.",
    match = ["codex login", "claude logout"],
)

prefix_rule(
    pattern = ["linear-cli", "auth", ["login", "logout", "migrate", "oauth", "revoke"]],
    decision = "prompt",
    justification = "Authentication through Linear is routine in task scope; never extract or print API keys.",
    match = ["linear-cli auth login", "linear-cli auth oauth"],
    not_match = ["linear-cli auth status"],
)

prefix_rule(
    pattern = ["linear-cli", "config", ["set-key", "set", "workspace-add", "workspace-switch", "workspace-remove"]],
    decision = "prompt",
    justification = "Linear workspace and non-secret config changes are routine in task scope; credentials stay in the owning store.",
    match = ["linear-cli config set-key", "linear-cli config set default-team ENG"],
    not_match = ["linear-cli config show", "linear-cli config workspace-list"],
)

prefix_rule(
    pattern = ["linear-cli", "setup"],
    decision = "prompt",
    justification = "Linear's guided setup is routine in task scope; the user completes interactive prompts.",
    match = ["linear-cli setup"],
)

prefix_rule(
    pattern = ["linear-cli", "config", "get"],
    decision = "prompt",
    justification = "Approve masked or non-secret config reads; deny api-key with --raw in any flag position.",
    match = ["linear-cli config get api-key", "linear-cli config get api-key --output json --raw"],
    not_match = ["linear-cli config show"],
)

prefix_rule(
    pattern = ["linear-cli", "config", "get", ["api-key", "api_key"], "--raw"],
    decision = "forbidden",
    justification = "Never reveal Linear API keys; use masked config output.",
    match = ["linear-cli config get api-key --raw"],
    not_match = ["linear-cli config get api-key"],
)

prefix_rule(
    pattern = ["linear-cli", "config", "get", "--raw", ["api-key", "api_key"]],
    decision = "forbidden",
    justification = "Never reveal Linear API keys; use masked config output.",
    match = ["linear-cli config get --raw api-key"],
    not_match = ["linear-cli config get --raw default-team"],
)

prefix_rule(
    pattern = ["lightdash", "login"],
    decision = "prompt",
    justification = "Authentication through Lightdash is routine in task scope; the user completes interactive prompts.",
    match = ["lightdash login https://app.lightdash.cloud"],
    not_match = ["lightdash compile"],
)

prefix_rule(
    pattern = ["lightdash", "config", "set-project"],
    decision = "prompt",
    justification = "Selecting the task's Lightdash project is routine; project selection does not authorize production writes.",
    match = ["lightdash config set-project --name x"],
    not_match = ["lightdash config get-project"],
)
