prefix_rule(
    pattern = [["rem", "/opt/homebrew/bin/rem"], ["help", "--help", "version", "--version", "list", "ls", "lists", "show", "get", "search", "stats", "today", "overdue", "upcoming", "add", "create", "new"]],
    decision = "allow",
    justification = "Reminders uses host EventKit access; reads and single-reminder creation run outside the sandbox.",
    match = ["rem list -o json", "rem add Task --list Reminders", "/opt/homebrew/bin/rem show ABCD"],
    not_match = ["rem complete ABCD", "rem delete ABCD", "rem export --output-file reminders.json", "rem update ABCD --list Shared"],
)

prefix_rule(
    pattern = [["rem", "/opt/homebrew/bin/rem"], ["complete", "done", "uncomplete", "flag", "unflag", "update", "edit", "delete", "rm", "remove", "import", "export", "list-mgmt", "lm", "interactive", "i", "skills"]],
    decision = "prompt",
    justification = "Review status mutations, exports, deletion, bulk import, list management, shared-list-capable updates, interactive operations, and skill installation.",
    match = ["rem complete ABCD", "rem complete ABCD EFGH", "rem delete ABCD EFGH --force", "rem export --output-file reminders.json", "rem import tasks.json", "rem lm delete Work", "rem update ABCD --list Shared"],
    not_match = ["rem list -o json", "rem add Task --list Reminders"],
)
