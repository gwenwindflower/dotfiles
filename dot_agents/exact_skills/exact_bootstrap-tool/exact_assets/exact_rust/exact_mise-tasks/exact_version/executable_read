#!/usr/bin/env bash
#MISE description="Print the package version from Cargo.toml, the source of truth"
#MISE quiet=true

set -euo pipefail
cd "${MISE_PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"

awk '
  $0 == "[package]" { package = 1; next }
  package && /^\[/ { exit }
  package && /^[[:space:]]*version[[:space:]]*=/ { sub(/^[^"]*"/, ""); sub(/".*$/, ""); print; exit }
' Cargo.toml
